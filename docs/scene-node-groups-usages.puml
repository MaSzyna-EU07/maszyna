@startuml
left to right direction

allowmixing

class "scene::node_groups" as NodeGroups
object "scene::Groups" as Groups <<node_groups>>

package "Wczytywanie sceny" {

  component "utilities/parser.cpp\ncParser" as Parser
  component "simulation/simulationstateserializer.cpp\nstate_serializer" as Serializer
  Parser --> Groups : create(), close()
  Serializer --> Groups : create(), close(), insert(),\nhandle(), export_as_text()
}

package "Edytor" {
  component "scene/sceneeditor.cpp\nbasic_editor" as SceneEditor
  component "application/editormodeselection.cpp\neditor_mode" as Selection
  component "application/editormode.cpp\neditor_mode" as EditorMode
  component "application/editoruipanels.cpp\nitemproperties_panel" as Panels

  SceneEditor --> Groups : group()
  Selection --> Groups : group(), make(), dissolve()
  EditorMode --> Groups : remove()
  Panels --> Groups : group()
}

package "Zapis sceny" {
  component "scene/scenelayerssave.cpp" as LayerSave
  LayerSave --> Groups : relocating(), loose(), rewritten(),\ngroup(), saved()
}

note right of NodeGroups
  Implementacja w
  scene/scenenodegroups.cpp
end note

@enduml
