# events for: -graph-run consist.vhg -script consist.script -consist consist.vhg:r -consist consist-short.vhg -consist consist.vhg
# options: -consist consist.vhg:r -consist consist-short.vhg -consist consist.vhg
# direction from vehicle 1, then from vehicle 2 (facing the other way)
0.5   force  dir.q 1
1.0   force  dir.q 0
1.0   force  2:dir.q 1
# controller: vehicle 1 drives, vehicle 2 gives a value without driving, then drives as well; vehicle 4 alone
1.5   force  ctrl.q 0.6
1.5   force  ctrl_act.q 1
1.5   force  2:ctrl.q 0.9
2.0   force  2:ctrl_act.q 1
2.0   force  4:ctrl.q 0.3
2.0   force  4:ctrl_act.q 1
# left doors of vehicle 1: the right doors of vehicle 2
2.5   force  door_l.q 1
3.0   force  door_l.q 0
3.0   force  2:door_l.q 1
