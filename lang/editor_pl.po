# scenery editor: vertical profile

msgid "Point"
msgstr "Punkt"

msgid "Points"
msgstr "Punkty"

msgid "Remarks"
msgstr "Uwagi"

msgid "Keeps the elevation of the joint and takes over the grade of the adjoining track,\nwith a vertical curve which starts right at the joint"
msgstr "Zachowuje wysokość styku i przejmuje pochylenie przylegającego toru,\nz łukiem pionowym zaczynającym się zaraz na styku"

msgid "Join the adjoining track at the start"
msgstr "Dowiąż do przylegającego toru na początku"

msgid "Join the adjoining track at the end"
msgstr "Dowiąż do przylegającego toru na końcu"

msgid "Limits"
msgstr "Ograniczenia"

msgid "Automatic R at all points"
msgstr "Ustaw automatyczny R wszędzie"

msgid "Required R for %.0f km/h: %.0f m"
msgstr "Wymagany R dla %.0f km/h: %.0f m"

msgid "The grade line meets the limits"
msgstr "Niweleta zgodna z normami"

msgid "Sets the heights of the track along the route to the grade line, Ctrl+Z takes it back"
msgstr "Ustawia wysokości toru wzdłuż trasy według niwelety, Ctrl+Z cofa"

msgid "LMB on a remark shows its place"
msgstr "LPM na uwadze pokazuje jej miejsce"

msgid "sag"
msgstr "załom wklęsły"

msgid "crest"
msgstr "załom wypukły"

msgid "No point selected. Click a point of the grade line in the plot, or double click the line to add one."
msgstr "Nie wybrano punktu. Kliknij punkt niwelety na wykresie albo kliknij dwukrotnie linię, aby dodać nowy"

msgid "Point %d: joint with the adjoining track"
msgstr "Punkt %d: styk z przylegającym torem"

msgid "Grade %+.2f -> %+.2f per mille (%s)"
msgstr "Pochylenie %+.2f -> %+.2f ‰ (%s)"

msgid "Placed automatically, moves with the neighbouring point; untick the joining in the inspector to edit the end freely"
msgstr "Ustawiany automatycznie, porusza się z sąsiednim punktem; odznacz dowiązanie w inspektorze, aby swobodnie edytować koniec"

msgid "Point %d"
msgstr "Punkt %d"

msgid ", joined to the adjoining track"
msgstr ", dowiązany do przylegającego toru"

msgid ", end of the route"
msgstr ", koniec trasy"

msgid "auto"
msgstr "auto"

msgid "R follows the limits: the required radius where the change of grade needs a curve; 0: no curve"
msgstr "R wynika z norm: wymagany promień tam, gdzie zmiana pochylenia wymaga łuku; 0: bez łuku"

msgid "Change of grade %+.2f per mille, %s"
msgstr "Zmiana pochylenia %+.2f ‰, %s"

msgid "Tangent T %.2f m, sagitta f %.3f m"
msgstr "Styczna T %.2f m, strzałka f %.3f m"

msgid "Add a point after"
msgstr "Dodaj punkt za"

msgid "Remove  Del"
msgstr "Usuń  Del"

msgid " joint"
msgstr " styk"

msgid "heights x%.0f"
msgstr "wysokości x%.0f"

msgid "Exaggeration of the heights against the lengths, also Ctrl+wheel over the plot"
msgstr "Przewyższenie wysokości względem długości, także Ctrl+kółko nad wykresem"

msgid "Fit"
msgstr "Pokaż całość"

msgid "Shows the whole route"
msgstr "Pokazuje całą trasę"

msgid "before %+.2f per mille"
msgstr "przed %+.2f ‰"

msgid "after %+.2f per mille"
msgstr "za %+.2f ‰"

msgid "plan: curvature (up: left)"
msgstr "plan: krzywizna (w górę: w lewo)"

msgid "Grade line %.3f m, %+.2f per mille"
msgstr "Niweleta %.3f m, %+.2f ‰"

msgid "Track %.3f m (%+.3f), %+.2f per mille"
msgstr "Tor %.3f m (%+.3f), %+.2f ‰"

msgid "Terrain %.3f m, %s %.2f m"
msgstr "Teren %.3f m, %s %.2f m"

msgid "fill"
msgstr "nasyp"

msgid "cut"
msgstr "wykop"

msgid " (switch, tilted as a whole with its branch)"
msgstr " (rozjazd, pochylany w całości z odgałęzieniem)"

msgid "Maximum grade (per mille)"
msgstr "Największe pochylenie (‰)"

msgid "Maximum grade over switches (per mille)"
msgstr "Największe pochylenie na rozjazdach (‰)"

msgid "Vertical curve R >= k*V^2, k"
msgstr "Łuk pionowy R >= k*V^2, k"

msgid "Vertical curve R min (m)"
msgstr "Najmniejszy R łuku pionowego (m)"

msgid "Vertical curve needed above a change of (per mille)"
msgstr "Łuk pionowy potrzebny od zmiany pochylenia (‰)"

msgid "Constant grade between curves at least (m)"
msgstr "Najkrótszy odcinek stałego pochylenia (m)"

msgid "Tolerance at fixed points (m)"
msgstr "Tolerancja w punktach stałych (m)"

msgid "Chainage (m)"
msgstr "Kilometraż (m)"

msgid "Elevation (m)"
msgstr "Wysokość (m)"

msgid "Grade before (per mille)"
msgstr "Pochylenie przed (‰)"

msgid "Grade after (per mille)"
msgstr "Pochylenie za (‰)"

msgid "Vertical curve R (m)"
msgstr "R łuku pionowego (m)"

msgid "Grade line"
msgstr "Niweleta"

msgid "Tangents"
msgstr "Styczne"

msgid "Switches"
msgstr "Rozjazdy"

# scenery editor: track modes

msgid "Switches aren't a part of a line: T edits the switch, Esc goes back to Select"
msgstr "Rozjazdy nie są częścią linii: T edytuje rozjazd, Esc wraca do Wyboru"

msgid "Tracks"
msgstr "Tory"

msgid "Switches aren't a part of a line: LMB on a plain path"
msgstr "Rozjazdy nie są częścią linii: LPM na zwykłym torze"

msgid "back to Select"
msgstr "powrót do Wyboru"

msgid "move the selected switch"
msgstr "przesuwa zaznaczony rozjazd"

msgid "modes: lay, switch, straight, curve, profile, speed, infra"
msgstr "tryby: układanie, rozjazd, prosta, łuk, profil, prędkość, infrastruktura"

msgid "Select"
msgstr "Zaznaczanie"

msgid "LMB on a path selects it: its points, control vectors and parameters"
msgstr "LPM na torze zaznacza go: jego punkty, wektory sterujące i parametry"

msgid "Lay track"
msgstr "Układanie"

msgid "Puts switches into the selected straight or curve, edits the geometry of the selected switch"
msgstr "Wstawia rozjazdy w zaznaczoną prostą lub łuk, edytuje geometrię zaznaczonego rozjazdu"

msgid "Speed limits of the paths against the speed their geometry allows"
msgstr "Ograniczenia prędkości torów wobec prędkości dopuszczalnej przez geometrię"

msgid "Structure gauge"
msgstr "Skrajnia"

msgid "Checks which models enter the structure gauge of the tracks and the clearance over the roads (skrajnia budowli)"
msgstr "Sprawdza, które modele wchodzą w skrajnię, czyli wolną przestrzeń wokół toru potrzebną pociągom, i w skrajnię nad drogami"

msgid "The geometry of this switch is degenerate, it can't be edited here"
msgstr "Geometria tego rozjazdu jest błędna, nie da się jej tu edytować"

msgid "Length %.3f m, diverging %s, end offset %.3f m"
msgstr "Długość %.3f m, tor zwrotny %s, odsunięcie końca %.3f m"

msgid "left"
msgstr "w lewo"

msgid "right"
msgstr "w prawo"

msgid "Angle 1:%.2f (%.4f deg), R in the entry %.0f m"
msgstr "Skos 1:%.2f (%.4f°), R na wejściu %.0f m"

msgid "Too far from the new ends of the switch, left unjoined: "
msgstr "Za daleko od nowych końców rozjazdu, zostawione niepołączone: "

msgid "Replace the geometry with the template"
msgstr "Zastąp geometrię szablonem"

msgid "Flip the side"
msgstr "Odwróć stronę"

msgid "Ride and sound"
msgstr "Jazda i dźwięk"

msgid "Friction"
msgstr "Tarcie"

msgid "Sound distance"
msgstr "Odstęp stuków"

msgid "Quality"
msgstr "Jakość"

msgid "Damage flags"
msgstr "Flagi uszkodzeń"

msgid "Width"
msgstr "Szerokość"

msgid "Texture length"
msgstr "Długość tekstury"

msgid "Trackbed height"
msgstr "Wysokość podsypki"

msgid "Trackbed width"
msgstr "Szerokość podsypki"

msgid "Trackbed slope"
msgstr "Skarpa podsypki"

msgid "Track circuits"
msgstr "Odcinki izolowane"

msgid "The track circuits can't change while vehicles stand on the path"
msgstr "Odcinki izolowane nie mogą się zmienić, gdy na torze stoją pojazdy"

msgid "Speed with the pantographs lowered (km/h)"
msgstr "Prędkość z opuszczonymi pantografami (km/h)"

msgid "Sleeper models"
msgstr "Modele podkładów"

msgid "Give the sleeper model first"
msgstr "Najpierw podaj model podkładu"

msgid "Sleeper model"
msgstr "Model podkładu"

msgid "Path of the .e3d model, as in the scenery file"
msgstr "Ścieżka modelu .e3d, jak w pliku scenerii"

msgid "Sleeper skin"
msgstr "Skóra podkładu"

msgid "Replaceable skin of the model, \"none\": the one of the model"
msgstr "Wymienna skóra modelu, \"none\": ta z modelu"

msgid "Sleeper spacing (m)"
msgstr "Rozstaw podkładów (m)"

msgid "Distance between the sleepers along the path"
msgstr "Odległość między podkładami wzdłuż toru"

msgid "Trackbed shift (m)"
msgstr "Przesunięcie podsypki (m)"

msgid "Vertical shift of the drawn trackbed under the sleepers, negative lowers it"
msgstr "Pionowe przesunięcie rysowanej podsypki pod podkładami, ujemne ją obniża"

msgid "Events"
msgstr "Eventy"

msgid "%s  %s (by the name of the path)"
msgstr "%s  %s (po nazwie toru)"

msgid "%s  %s (no such event)"
msgstr "%s  %s (nie ma takiego eventu)"

msgid "Add"
msgstr "Dodaj"

msgid "The events can't change while vehicles stand on the path"
msgstr "Eventów nie można zmienić, gdy na torze stoją pojazdy"

msgid "No such events: %s"
msgstr "Nie ma takich eventów: %s"

msgid "No path selected"
msgstr "Nie zaznaczono toru"

msgid "Editing of this path type isn't supported"
msgstr "Edycja tego typu toru nie jest obsługiwana"

msgid "Geometry locked: %s"
msgstr "Geometria zablokowana: %s"

msgid "Geometry"
msgstr "Geometria"

msgid "Path %d"
msgstr "Tor %d"

msgid "(+) joined with another track, (-) a free end"
msgstr "(+) połączony z innym torem, (-) wolny koniec"

