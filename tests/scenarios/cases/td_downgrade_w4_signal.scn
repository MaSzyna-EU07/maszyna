// the W4 of the two stations of the timetable; the middle of the consist 2 m before it, leaves on time
include ip/pkp/w4n.inc gora#1 -2997.3 60.00 -60.0 180 0 0 2 202 end
include ip/pkp/w4n.inc dol#1 -2997.3 30.00 1500.0 180 0 0 2 202 end
// a signal at stop: what the AI reads of one, a memory cell with SetVelocity 0 0 and the event that reads it
node -1 0 gr_sem_mem memcell -2997.3 8.00 2600.0 SetVelocity 0.0 0.0 none endmemcell
event gr_sem_info getvalues 5.0 gr_sem_mem endevent

trainset {{timetable}} gr_02 0.0 0.1
{{consist}}
endtrainset
