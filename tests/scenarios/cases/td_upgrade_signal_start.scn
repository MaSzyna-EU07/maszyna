// the W4 of the stations of the timetable
include ip/pkp/w4n.inc gora#1 -2997.3 60.00 -90.0 180 0 0 -10 202 end
// a signal at stop: what the AI reads of one, a memory cell with SetVelocity 0 0 and the event that reads it
node -1 0 hu_sem1_mem memcell -2997.3 78.00 1000.0 SetVelocity 0.0 0.0 none endmemcell
event hu_sem1_info getvalues 5.0 hu_sem1_mem endevent
// cleared at 10:42: the memory cell lets the train go at the line speed
event hu_sem1_go updatevalues 0.0 hu_sem1_mem SetVelocity 100 100 endevent
node -1 0 hu_sem1_launcher eventlauncher 0 0 0 -1 none 1042 hu_sem1_go end
// a signal at stop: what the AI reads of one, a memory cell with SetVelocity 0 0 and the event that reads it
node -1 0 hu_sem2_mem memcell -2997.3 91.00 2300.0 SetVelocity 0.0 0.0 none endmemcell
event hu_sem2_info getvalues 5.0 hu_sem2_mem endevent

trainset {{timetable}} hu_05 0.0 0.1
