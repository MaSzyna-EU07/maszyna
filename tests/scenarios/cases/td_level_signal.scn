// the W4 of the stations of the timetable
include ip/pkp/w4n.inc gora#1 -2997.3 60.00 -90.0 180 0 0 -10 202 end
// a signal at stop: what the AI reads of one, a memory cell with SetVelocity 0 0 and the event that reads it
