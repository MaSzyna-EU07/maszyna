// added by tests/scenarios/run.py to the base scenery, whose own trainsets were removed:
// the trainset goes after FirstInit, the launcher before it.
// the EU07 stands where td.scn keeps its timetable train and gets the same timetable.
trainset td/rozklad tdo_n1734 0.0 0.1
node -1 0 autotest_eu07 dynamic pkp\4e_v1 4e-004 4e 0 headdriver 0 0 enddynamic
endtrainset

// td.scn sets routes from the keyboard (shift+1..4 run events keyctrl01..04). keyctrl04 is the
// way out of the track the train stands on: switch zwr02 and the exit signal stacja1_j at 40.
// a launcher with a positive time fires once at that hour (HHMM), radius -1 means anywhere.
node -1 0 autotest_route eventlauncher 0 0 0 -1 none 1034 keyctrl04 end
